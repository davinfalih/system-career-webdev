generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String?
  image          String?
  role           String          @default("STUDENT")
  status         String          @default("ACTIVE")
  verified       Boolean         @default(false)
  nim            String?
  graduationYear Int?
  gpa            Float?
  major          String?
  institutionId  String?
  institution    Institution?    @relation(fields: [institutionId], references: [id])
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id])
  profile        StudentProfile?
  cvs            CV[]
  applications   Application[]
  bookmarks      Bookmark[]
  notifications  Notification[]
  userSkills     UserSkill[]
  passwordResetTokens PasswordResetToken[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  headline    String?
  bio         String?
  location    String?
  phone       String?
  skills      String?
  education   String?
  experiences String?
  projects    String?
  cvScore     Int      @default(0)
  atsScore    Int      @default(0)
  aiReview    String?
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model CV {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  filename  String
  text      String?  @db.LongText
  analysis  String?  @db.LongText
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  description String
  industry    String
  location    String
  verified    Boolean  @default(false)
  legalDoc    String?
  users       User[]
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Institution {
  id            String              @id @default(cuid())
  name          String
  type          String
  city          String?
  verified      Boolean             @default(false)
  users         User[]
  tracerStudies TracerStudyRecord[]
  createdAt     DateTime            @default(now())
}

model Job {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  title            String
  type             String        @default("INTERNSHIP")
  mode             String        @default("REMOTE")
  location         String?
  salary           String?
  description      String
  mustHaveSkills   String
  niceToHaveSkills String
  majorRequired    String?
  minGpa           Float?
  forFreshGrads    Boolean       @default(true)
  status           String        @default("OPEN")
  deadline         DateTime?
  applications     Application[]
  bookmarks        Bookmark[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  jobId      String
  status     String            @default("SUBMITTED")
  matchScore Int?
  coverNote  String?
  user       User              @relation(fields: [userId], references: [id])
  job        Job               @relation(fields: [jobId], references: [id])
  interview  Interview?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, jobId])
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  scheduledAt   DateTime
  link          String?
  notes         String?
  createdAt     DateTime    @default(now())
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id])
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Skill {
  id        String       @id @default(cuid())
  name      String       @unique
  category  String
  demand    Int          @default(50)
  userSkills UserSkill[]
  createdAt DateTime     @default(now())
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  level   Int    @default(3)
  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TracerStudyRecord {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  year           Int
  totalGraduates Int
  employed       Int
  interned       Int
  continueStudy  Int
  unemployed     Int
  averageIncome  String?
  createdAt      DateTime    @default(now())

  @@unique([institutionId, year])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
